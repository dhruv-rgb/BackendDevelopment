<%- include('partials/header') %>

<div class="form-page-container">
  <div class="form-card">
    <div class="form-header">
      <a href="/tasks" class="back-link">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2">
          <line x1="19" y1="12" x2="5" y2="12"></line>
          <polyline points="12 19 5 12 12 5"></polyline>
        </svg>
        <span>Back to Matrix</span>
      </a>
      <h1 class="form-title">Edit Task</h1>
      <p class="form-subtitle">Update task details or reassign urgency and importance.</p>
    </div>

    <% if (errorMessage) { %>
      <div class="alert alert-error">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <circle cx="12" cy="12" r="10"></circle>
          <line x1="12" y1="8" x2="12" y2="12"></line>
          <line x1="12" y1="16" x2="12.01" y2="16"></line>
        </svg>
        <span><%= errorMessage %></span>
      </div>
    <% } %>

    <form action="/tasks/<%= task._id %>/edit" method="POST" class="task-form" id="editTaskForm">
      <!-- Title -->
      <div class="form-group">
        <label for="title" class="form-label required">Task Title</label>
        <input 
          type="text" 
          id="title" 
          name="title" 
          class="form-control" 
          value="<%= task.title %>" 
          required 
          autofocus
        >
      </div>

      <!-- Description -->
      <div class="form-group">
        <label for="description" class="form-label">Description</label>
        <textarea 
          id="description" 
          name="description" 
          class="form-control" 
          rows="3"
        ><%= task.description || '' %></textarea>
      </div>

      <!-- Category & Due Date Row -->
      <div class="form-row">
        <div class="form-group col-half">
          <label for="category" class="form-label">Category / Tag</label>
          <select id="category" name="category" class="form-control">
            <option value="Academic" <%= task.category === 'Academic' ? 'selected' : '' %>>Academic</option>
            <option value="Work" <%= task.category === 'Work' ? 'selected' : '' %>>Work</option>
            <option value="Personal" <%= task.category === 'Personal' ? 'selected' : '' %>>Personal</option>
            <option value="Communication" <%= task.category === 'Communication' ? 'selected' : '' %>>Communication</option>
            <option value="General" <%= task.category === 'General' ? 'selected' : '' %>>General</option>
          </select>
        </div>

        <div class="form-group col-half">
          <label for="dueDate" class="form-label">Due Date (Optional)</label>
          <input 
            type="date" 
            id="dueDate" 
            name="dueDate" 
            class="form-control" 
            value="<%= task.dueDate || '' %>"
          >
        </div>
      </div>

      <!-- Eisenhower Matrix Checkboxes -->
      <div class="form-group">
        <label class="form-label">Eisenhower Priority Matrix Classification</label>
        <div class="checkbox-cards-grid">
          <label class="checkbox-card" for="isUrgent">
            <input 
              type="checkbox" 
              id="isUrgent" 
              name="isUrgent" 
              <%= task.isUrgent ? 'checked' : '' %>
            >
            <div class="checkbox-card-body">
              <span class="checkbox-card-title">Is Urgent</span>
              <span class="checkbox-card-desc">Requires immediate action; time-sensitive deadline.</span>
            </div>
          </label>

          <label class="checkbox-card" for="isImportant">
            <input 
              type="checkbox" 
              id="isImportant" 
              name="isImportant" 
              <%= task.isImportant ? 'checked' : '' %>
            >
            <div class="checkbox-card-body">
              <span class="checkbox-card-title">Is Important</span>
              <span class="checkbox-card-desc">Contributes to key long-term goals and high-value outcomes.</span>
            </div>
          </label>
        </div>
      </div>

      <!-- Dynamic Matrix Placement Preview -->
      <div class="matrix-preview-banner" id="matrixPreview">
        <div class="preview-icon" id="previewIcon">🎯</div>
        <div class="preview-text">
          <span class="preview-label">Assigned Quadrant:</span>
          <strong id="previewQuadrant">Q1: DO (Urgent & Important)</strong>
        </div>
      </div>

      <!-- Action Buttons -->
      <div class="form-actions">
        <button type="submit" class="btn btn-primary btn-lg">Save Changes</button>
        <a href="/tasks" class="btn btn-outline btn-lg">Cancel</a>
      </div>
    </form>
  </div>
</div>

<script>
  // Live Eisenhower Quadrant Preview
  const urgentCheckbox = document.getElementById('isUrgent');
  const importantCheckbox = document.getElementById('isImportant');
  const previewBanner = document.getElementById('matrixPreview');
  const previewQuadrant = document.getElementById('previewQuadrant');
  const previewIcon = document.getElementById('previewIcon');

  function updatePreview() {
    const isUrgent = urgentCheckbox.checked;
    const isImportant = importantCheckbox.checked;

    previewBanner.className = 'matrix-preview-banner';

    if (isUrgent && isImportant) {
      previewBanner.classList.add('preview-q1');
      previewIcon.textContent = '🎯';
      previewQuadrant.textContent = 'Quadrant 1: DO (Urgent & Important) — High urgency, high importance';
    } else if (!isUrgent && isImportant) {
      previewBanner.classList.add('preview-q2');
      previewIcon.textContent = '📅';
      previewQuadrant.textContent = 'Quadrant 2: SCHEDULE (Not Urgent & Important) — Plan & schedule ahead';
    } else if (isUrgent && !isImportant) {
      previewBanner.classList.add('preview-q3');
      previewIcon.textContent = '🤝';
      previewQuadrant.textContent = 'Quadrant 3: DELEGATE (Urgent & Not Important) — High urgency, low importance';
    } else {
      previewBanner.classList.add('preview-q4');
      previewIcon.textContent = '🗑️';
      previewQuadrant.textContent = 'Quadrant 4: ELIMINATE (Not Urgent & Not Important) — Low priority / drop';
    }
  }

  urgentCheckbox.addEventListener('change', updatePreview);
  importantCheckbox.addEventListener('change', updatePreview);
  updatePreview();
</script>

<%- include('partials/footer') %>

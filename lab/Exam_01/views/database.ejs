<%- include('partials/header') %>

<div class="matrix-page-container">
  <!-- DB Header Banner -->
  <div class="matrix-hero" style="border-left: 4px solid #10b981;">
    <div class="hero-left">
      <div style="display: flex; align-items: center; gap: 0.6rem; margin-bottom: 0.3rem;">
        <span style="background: #d1fae5; color: #065f46; font-size: 0.75rem; font-weight: 700; padding: 0.2rem 0.6rem; border-radius: 9999px;">
          ● MongoDB Active
        </span>
        <span style="font-family: monospace; font-size: 0.85rem; color: #64748b;">
          <%= mongoURL %>
        </span>
      </div>
      <h1 class="hero-title" style="display: flex; align-items: center; gap: 0.5rem;">
        <span>Database: <code style="color: #059669;"><%= dbName %></code></span>
        <span style="color: #cbd5e1;">/</span>
        <span>Collection: <code style="color: #4f46e5;">tasks</code></span>
      </h1>
      <p class="hero-subtitle">
        Viewing raw documents stored in the MongoDB collection as required by the Lab Exam specification.
      </p>
    </div>

    <!-- Quick DB Stats -->
    <div class="matrix-stats-bar">
      <div class="stat-pill stat-total">
        <span class="stat-num"><%= tasks.length %></span>
        <span class="stat-lbl">Documents</span>
      </div>
      <div class="stat-pill stat-q1">
        <span class="stat-num"><%= tasks.filter(t => t.isUrgent && t.isImportant).length %></span>
        <span class="stat-lbl">Q1 Docs</span>
      </div>
      <div class="stat-pill stat-q2">
        <span class="stat-num"><%= tasks.filter(t => !t.isUrgent && t.isImportant).length %></span>
        <span class="stat-lbl">Q2 Docs</span>
      </div>
      <div class="stat-pill stat-q3">
        <span class="stat-num"><%= tasks.filter(t => t.isUrgent && !t.isImportant).length %></span>
        <span class="stat-lbl">Q3 Docs</span>
      </div>
      <div class="stat-pill stat-q4">
        <span class="stat-num"><%= tasks.filter(t => !t.isUrgent && !t.isImportant).length %></span>
        <span class="stat-lbl">Q4 Docs</span>
      </div>
    </div>
  </div>

  <!-- Action Bar -->
  <div class="filter-controls-card" style="display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 0.75rem;">
    <div style="display: flex; align-items: center; gap: 0.5rem;">
      <a href="/tasks" class="btn btn-outline btn-sm">
        &larr; Back to Eisenhower Matrix
      </a>
      <a href="/api/tasks" target="_blank" class="btn btn-secondary btn-sm" title="View as raw JSON">
        <span>{ } View Raw JSON API</span>
      </a>
    </div>
    <div style="font-size: 0.8rem; color: #64748b;">
      Collection: <strong><%= dbName %>.tasks</strong> &bull; Total Documents: <strong><%= tasks.length %></strong>
    </div>
  </div>

  <!-- Documents Table / Compass-like Viewer -->
  <div style="background: #ffffff; border: 1px solid var(--border-subtle); border-radius: var(--radius-md); box-shadow: var(--shadow-sm); overflow-x: auto;">
    <table style="width: 100%; border-collapse: collapse; font-size: 0.85rem; text-align: left;">
      <thead>
        <tr style="background: #f8fafc; border-bottom: 2px solid var(--border-subtle); color: #475569; font-weight: 700;">
          <th style="padding: 0.85rem 1rem;">_id (ObjectId)</th>
          <th style="padding: 0.85rem 1rem;">title</th>
          <th style="padding: 0.85rem 1rem;">description</th>
          <th style="padding: 0.85rem 1rem;">isUrgent</th>
          <th style="padding: 0.85rem 1rem;">isImportant</th>
          <th style="padding: 0.85rem 1rem;">category</th>
          <th style="padding: 0.85rem 1rem;">dueDate</th>
          <th style="padding: 0.85rem 1rem;">createdAt</th>
          <th style="padding: 0.85rem 1rem;">Actions</th>
        </tr>
      </thead>
      <tbody>
        <% if (tasks.length === 0) { %>
          <tr>
            <td colspan="9" style="padding: 2.5rem; text-align: center; color: #94a3b8;">
              No documents in collection. <a href="/tasks/new" style="color: #4f46e5; font-weight: 600;">+ Insert a new document</a>
            </td>
          </tr>
        <% } else { %>
          <% tasks.forEach((task, index) => { %>
            <tr style="border-bottom: 1px solid var(--border-subtle); background: <%= index % 2 === 0 ? '#ffffff' : '#fbfcfd' %>;">
              <td style="padding: 0.75rem 1rem; font-family: monospace; color: #0284c7; font-weight: 600; white-space: nowrap;">
                ObjectId("<%= task._id %>")
              </td>
              <td style="padding: 0.75rem 1rem; font-weight: 700; color: #0f172a;">
                <%= task.title %>
              </td>
              <td style="padding: 0.75rem 1rem; color: #475569; max-width: 250px;">
                <%= task.description || '<em style="color:#cbd5e1;">empty</em>' %>
              </td>
              <td style="padding: 0.75rem 1rem;">
                <span style="background: <%= task.isUrgent ? '#fee2e2' : '#f1f5f9' %>; color: <%= task.isUrgent ? '#991b1b' : '#64748b' %>; font-weight: 700; padding: 0.2rem 0.5rem; border-radius: 4px; font-size: 0.75rem;">
                  <%= task.isUrgent %>
                </span>
              </td>
              <td style="padding: 0.75rem 1rem;">
                <span style="background: <%= task.isImportant ? '#dbeafe' : '#f1f5f9' %>; color: <%= task.isImportant ? '#1e40af' : '#64748b' %>; font-weight: 700; padding: 0.2rem 0.5rem; border-radius: 4px; font-size: 0.75rem;">
                  <%= task.isImportant %>
                </span>
              </td>
              <td style="padding: 0.75rem 1rem;">
                <span class="badge-category"><%= task.category || 'General' %></span>
              </td>
              <td style="padding: 0.75rem 1rem; color: #d97706; font-weight: 600; font-size: 0.8rem; white-space: nowrap;">
                <%= task.dueDate || '—' %>
              </td>
              <td style="padding: 0.75rem 1rem; color: #64748b; font-size: 0.75rem; white-space: nowrap;">
                <%= new Date(task.createdAt).toLocaleString() %>
              </td>
              <td style="padding: 0.75rem 1rem; white-space: nowrap;">
                <a href="/tasks/<%= task._id %>/edit" class="btn-action btn-edit" style="margin-right: 0.3rem;">Edit</a>
                <form action="/tasks/<%= task._id %>/delete" method="POST" style="display:inline;" onsubmit="return confirm('Delete document?');">
                  <button type="submit" class="btn-action btn-delete">Delete</button>
                </form>
              </td>
            </tr>
          <% }) %>
        <% } %>
      </tbody>
    </table>
  </div>

  <!-- Raw JSON Document Inspector (Compass Equivalent) -->
  <div style="background: #ffffff; border: 1px solid var(--border-subtle); border-radius: var(--radius-md); padding: 1.25rem; box-shadow: var(--shadow-sm); margin-top: 1rem;">
    <h3 style="font-size: 1rem; font-weight: 700; margin-bottom: 0.5rem; color: #0f172a; display: flex; align-items: center; gap: 0.5rem;">
      <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
        <polyline points="16 18 22 12 16 6"></polyline>
        <polyline points="8 6 2 12 8 18"></polyline>
      </svg>
      <span>MongoDB Document JSON (BSON representation)</span>
    </h3>
    <pre style="background: #0f172a; color: #f8fafc; padding: 1.25rem; border-radius: 8px; overflow-x: auto; font-size: 0.825rem; line-height: 1.6; max-height: 380px;"><code><%= JSON.stringify(tasks, null, 2) %></code></pre>
  </div>
</div>

<%- include('partials/footer') %>

<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= title %> | Eisenhower Todo</title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="/css/style.css">
</head>
<body>
<header class="app-header">
  <div class="header-container">
    <div class="brand">
      <a href="/tasks" class="brand-link">
        <div class="brand-icon">
          <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
            <rect x="3" y="3" width="18" height="18" rx="2"/>
            <path d="M3 9h18"/>
            <path d="M9 21V9"/>
          </svg>
        </div>
        <div class="brand-text">
          <span class="brand-title">Eisenhower Todo</span>
          <span class="brand-subtitle">Matrix Productivity System</span>
        </div>
      </a>
    </div>

    <div class="header-actions">
      <div class="student-pill">
        <span class="dot"></span>
        <span class="student-name">Dhruv Mehta</span>
        <span class="student-sap">SAP: 590016903</span>
      </div>
      <a href="/database" class="btn btn-outline" style="border-color: #10b981; color: #059669; font-weight: 700; display: inline-flex; align-items: center; gap: 0.35rem;" title="Inspect raw MongoDB collection and documents">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2">
          <ellipse cx="12" cy="5" rx="9" ry="3"></ellipse>
          <path d="M21 12c0 1.66-4 3-9 3s-9-1.34-9-3"></path>
          <path d="M3 5v14c0 1.66 4 3 9 3s9-1.34 9-3V5"></path>
        </svg>
        <span>MongoDB Database</span>
      </a>
      <a href="/tasks/new" class="btn btn-primary">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
          <line x1="12" y1="5" x2="12" y2="19"></line>
          <line x1="5" y1="12" x2="19" y2="12"></line>
        </svg>
        <span>Add Task</span>
      </a>
    </div>
  </div>
</header>
<main class="main-content">

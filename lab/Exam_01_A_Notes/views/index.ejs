<%- include('partials/header', { title: 'All Notes' }) %>

<section class="toolbar-section">
  <div class="toolbar-header">
    <div>
      <h1 class="page-title">My Notes</h1>
      <span class="stats-badge"><%= notes.length %> <%= notes.length === 1 ? 'Note' : 'Notes' %> Available</span>
    </div>
    <a href="/notes/new" class="btn btn-primary">+ Add New Note</a>
  </div>

  <!-- Search and Category Filter (Bonus Feature) -->
  <form action="/notes" method="GET" class="search-filter-form">
    <div class="search-input-group">
      <span class="search-icon">🔍</span>
      <input 
        type="text" 
        name="search" 
        class="search-input" 
        placeholder="Search notes by title..." 
        value="<%= typeof searchQuery !== 'undefined' ? searchQuery : '' %>"
      >
    </div>

    <select name="category" class="filter-select" onchange="this.form.submit()">
      <option value="">All Categories</option>
      <% const categories = ['Study', 'Work', 'Personal', 'Ideas', 'General']; %>
      <% categories.forEach(cat => { %>
        <option value="<%= cat %>" <%= (typeof selectedCategory !== 'undefined' && selectedCategory === cat) ? 'selected' : '' %>>
          <%= cat %>
        </option>
      <% }); %>
    </select>

    <button type="submit" class="btn btn-secondary">Search</button>

    <% if ((typeof searchQuery !== 'undefined' && searchQuery) || (typeof selectedCategory !== 'undefined' && selectedCategory)) { %>
      <a href="/notes" class="clear-btn">✕ Clear Filters</a>
    <% } %>
  </form>
</section>

<% if (notes.length === 0) { %>
  <!-- Empty State (Compulsory Requirement) -->
  <div class="empty-state">
    <div class="empty-icon">📋</div>
    <h3 class="empty-title">No notes found</h3>
    <p class="empty-description">
      <% if ((typeof searchQuery !== 'undefined' && searchQuery) || (typeof selectedCategory !== 'undefined' && selectedCategory)) { %>
        No notes matched your search criteria. Try clearing the filter or search with different keywords.
      <% } else { %>
        You haven't created any notes yet. Click the button below to add your first note!
      <% } %>
    </p>
    <a href="/notes/new" class="btn btn-primary">+ Create Your First Note</a>
  </div>
<% } else { %>
  <!-- Notes Grid Displaying All Notes -->
  <div class="notes-grid">
    <% notes.forEach(note => { %>
      <div class="note-card">
        <div class="note-card-header">
          <h2 class="note-title"><%= note.title %></h2>
          <% 
            const catClass = (note.category || 'General').toLowerCase();
            const badgeClass = ['study', 'work', 'personal', 'ideas'].includes(catClass) ? `badge-${catClass}` : 'badge-general';
          %>
          <span class="category-badge <%= badgeClass %>"><%= note.category || 'General' %></span>
        </div>
        
        <div class="note-card-body">
          <p class="note-content"><%= note.content %></p>
        </div>

        <div class="note-card-footer">
          <div class="note-date">
            <span>📅</span>
            <time datetime="<%= note.createdAt ? new Date(note.createdAt).toISOString() : '' %>">
              <%= note.createdAt ? new Date(note.createdAt).toLocaleDateString('en-US', { year: 'numeric', month: 'short', day: 'numeric', hour: '2-digit', minute: '2-digit' }) : 'N/A' %>
            </time>
          </div>

          <div class="note-actions">
            <!-- Edit Button (Bonus Feature) -->
            <a href="/notes/<%= note._id %>/edit" class="btn btn-outline" title="Edit Note">
              ✏️ Edit
            </a>

            <!-- Delete Form (Compulsory Requirement) -->
            <form action="/notes/<%= note._id %>/delete" method="POST" onsubmit="return confirm('Are you sure you want to delete this note?');" style="margin: 0;">
              <button type="submit" class="btn btn-danger" title="Delete Note">
                🗑️ Delete
              </button>
            </form>
          </div>
        </div>
      </div>
    <% }); %>
  </div>
<% } %>

<%- include('partials/footer') %>
